# MedGuard Environment Configuration Example
# Copy to .env and adjust as necessary

# Operational Mode
MODE=demo                         # demo | live
FREE_TIER_MODE=true               # true | false
CHANNEL=simulator                 # simulator | whatsapp
ALLOW_REAL_PATIENT_DATA=false     # true | false (refuse non-synthetic patient data if false in free tier)

# LLM & AI Gateway
GEMINI_API_KEY=                   # Google AI Studio API key
LLM_PROVIDER=gemini               # gemini | stub
LLM_MODEL=gemini-2.5-flash
LLM_MAX_CALLS_PER_SESSION=15
LLM_MAX_CALLS_PER_DAY=200
LLM_RPM_LIMIT=5                   # Token bucket rate limit
PANEL_MODE=single_call            # single_call | multi_call
REQUIRE_CLINICIAN_APPROVAL_FOR_AI_COMMENTARY=true

# Voice & Vision Providers
STT_PROVIDER=whisper              # whisper | stub
STT_MODEL_SIZE=base
TTS_PROVIDER=browser              # browser | gtts | stub
OCR_PROVIDER=tesseract            # tesseract | stub
TRANSLATE_PROVIDER=llm            # llm | stub

# Languages
SUPPORTED_LANGS=en,hi,kn
DEFAULT_LANG=en

# Database & Security
DATABASE_URL=sqlite:///./medguard.db
SECRET_KEY=dev-secret-key-change-in-production-32-bytes-long!
VAULT_KEY=u6fO7mZ8Z1WvL5K3d4R9Q2x8T1Y6P5m9J4w8C2k7L0g=   # 32 url-safe base64 bytes for Fernet

# WhatsApp Cloud API (Optional for live channel)
WA_VERIFY_TOKEN=medguard_verify_token
WA_APP_SECRET=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
MEDIA_RETENTION_HOURS=24

# Matching & Review Thresholds
MATCH_ACCEPT_THRESHOLD=0.90
MATCH_MARGIN_THRESHOLD=0.10
MATCH_CLARIFY_THRESHOLD=0.65
RULE_CHANGE_MIN_DECISIONS=5
RULE_CHANGE_REJECT_RATE=0.60

